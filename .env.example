# Runtime
WEB_PORT=8088
ENVIRONMENT=development
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
# Optional separate secret for the MCP service; keep it different in production.
MCP_INTERNAL_TOKEN=replace-with-a-different-long-random-token
# Set true when the auth service is served over HTTPS.
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=30
SESSION_MAX_SESSIONS=1024
SESSION_CLEANUP_BATCH_SIZE=100
SESSION_CLEANUP_OUTBOX_PATH=data/session-cleanup-outbox.jsonl
SESSION_STORE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ican:agent
REDIS_OPERATION_TIMEOUT_SECONDS=0.25
EVALUATION_RAW_ARCHIVE_PATH=data/evaluation-runs.raw.jsonl
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_MAX_BYTES=256000
RESPONSE_CACHE_MAX_ENTRIES=100000
RESPONSE_CACHE_SCOPE=tenant
RESPONSE_CACHE_LOCK_SECONDS=15
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_HEARTBEAT_INTERVAL_SECONDS=15
REALTIME_HANDSHAKE_TIMEOUT_SECONDS=5
REALTIME_IDLE_TIMEOUT_SECONDS=45
REALTIME_INTERRUPT_TIMEOUT_SECONDS=0.25
HTTP_ASR_ENDPOINT=
HTTP_ASR_API_KEY=
HTTP_ASR_TIMEOUT_SECONDS=30
HTTP_ASR_MAX_RESPONSE_BYTES=1048576
# 本地中文 ASR：默认启用 faster-whisper tiny，GPU 优先、不可用时自动 CPU。
ASR_INTERNAL_TOKEN=replace-with-a-local-asr-token
ASR_MODEL_SIZE=tiny
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
# 需要 GPU 时使用：docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build asr-service
ASR_BEAM_SIZE=1
ASR_MAX_AUDIO_BYTES=10485760
HTTP_TTS_ENDPOINT=
HTTP_TTS_API_KEY=
HTTP_TTS_TIMEOUT_SECONDS=8
HTTP_TTS_CHUNK_BYTES=640
HTTP_TTS_MAX_RESPONSE_BYTES=4194304
MAX_MESSAGE_LENGTH=4000
AGENT_MAX_REQUEST_BODY_BYTES=16777216
RABBITMQ_QUEUE=digital-human.presentation.v2
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=2
RABBITMQ_MAX_IN_FLIGHT=512
RABBITMQ_PREFETCH_COUNT=256
RABBITMQ_RETRY_LIMIT=3
AGENT_MAX_IN_FLIGHT_REQUESTS=4096
DEFAULT_PROVIDER=mock
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Optional host proxy for LLM traffic from Docker Desktop.
AGENT_HTTP_PROXY=
AGENT_HTTPS_PROXY=
AGENT_NO_PROXY=localhost,127.0.0.1,agent-service,auth-service,mcp-server,rabbitmq,web,asr-service
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_DIR=/app/model-cache/sentence-transformers
EMBEDDING_BATCH_SIZE=64
# Keep both loopback host spellings usable for browser WebSocket Origin checks.
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173,http://39.97.253.99:16666,https://39.97.253.99:16666
AGENT_REALTIME_PATH=/internal/realtime
# Bound the authenticated WebSocket relay queues and writes.
AGENT_REALTIME_MAX_QUEUE_BYTES=262144
AGENT_REALTIME_SEND_TIME_LIMIT_MS=10000
AGENT_REALTIME_BUFFER_SIZE_BYTES=524288
AGENT_REALTIME_MAX_CONNECTIONS=256

# Agent / MCP
MCP_SERVER_URL=http://mcp-server:9000/mcp
MCP_REQUEST_TIMEOUT_SECONDS=8
MCP_ALLOW_LOCAL_FALLBACK=true
# When local fallback is enabled, dead MCP endpoints are probed only briefly.
MCP_FAST_PATH_TIMEOUT_SECONDS=0.25
# Upper bound for provider cancellation cleanup before the run is detached.
PROVIDER_CANCEL_GRACE_SECONDS=0.25
# Bound tool payloads before they enter graph state, traces and browser responses.
MCP_MAX_RESULT_BYTES=65536
MCP_MAX_RESULT_ITEMS=256
MCP_MAX_RESULT_DEPTH=8
MCP_MAX_PARALLEL_TOOLS=4

# Evaluation (prices are configurable per 1K tokens)
EVALUATION_BUFFER_SIZE=2000
EVAL_INPUT_PRICE_PER_1K=0.003
EVAL_OUTPUT_PRICE_PER_1K=0.009
EVAL_CURRENCY=CNY

# Optional RAG
RAG_MAX_CHUNKS=5000
RAG_MAX_DOCUMENT_BYTES=8388608
# Bound JSON metadata before parsing/embedding; values are counts, not model settings.
RAG_MAX_METADATA_BYTES=65536
RAG_MAX_METADATA_ITEMS=128
RAG_MAX_METADATA_DEPTH=6
RAG_PARSE_CONCURRENCY=1
RAG_STORE_PATH=data/rag.sqlite3
RAG_STRICT_BINARY=true
RAG_CHUNK_MAX_CHARS=720
RAG_CHUNK_OVERLAP_CHARS=80
RAG_PARENT_MAX_CHARS=2400
RAG_PARENT_OVERLAP_CHARS=160
RAG_INDEX_TYPE=auto
RAG_HNSW_MIN_CHUNKS=256
RAG_HNSW_M=32
RAG_HNSW_EF_SEARCH=64
RAG_INDEX_CACHE_NAMESPACES=64
RAG_SEARCH_CACHE_TTL_SECONDS=30
RAG_SEARCH_CACHE_MAX_ENTRIES=2048
# Retrieval tuning. Each stage is independently switchable; disabling every
# optional stage degrades the pipeline back to plain vector ranking.
RAG_LEXICAL_ENABLED=true
RAG_LEXICAL_TOP_K=50
RAG_CANDIDATE_MULTIPLIER=8
RAG_RRF_K=60
RAG_RRF_VECTOR_WEIGHT=1.0
RAG_RRF_LEXICAL_WEIGHT=1.0
RAG_FUSION_POOL_SIZE=50
# Near-duplicate suppression: higher threshold suppresses less aggressively.
RAG_REDUNDANCY_THRESHOLD=0.8
RAG_SHORT_TEXT_EXEMPT_CHARS=24
# Numeric corroboration: relative tolerance above which values are a conflict.
RAG_NUMERIC_BOOST_ENABLED=true
RAG_NUMERIC_TOLERANCE=0.05
DOCLING_ENABLED=true
DOCLING_ARTIFACTS_PATH=
# Limit concurrent Docling converter calls; keep at 1 on CPU-only hosts.
DOCLING_MAX_CONCURRENCY=1
DOCLING_OCR_BACKEND=onnxruntime
DOCLING_OCR_LANG=chinese
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate

# Local telemetry fallback
OBSERVABILITY_BUFFER_SIZE=1000
# Bound asynchronous exporter tasks so telemetry cannot grow without limit.
OBSERVABILITY_MAX_PENDING_TASKS=256
# Maximum shutdown wait for pending telemetry exports.
OBSERVABILITY_PENDING_FLUSH_TIMEOUT_SECONDS=2

# Optional FutureAGI observability
FUTUREAGI_ENABLED=false
FUTUREAGI_ENDPOINT=
FUTUREAGI_API_KEY=
FUTUREAGI_SECRET_KEY=
FUTUREAGI_PROJECT=

# Optional provider configuration (never commit real values)
ALIYUN_AVATAR_ENABLED=false
ALIYUN_AVATAR_BASE_URL=
ALIYUN_AVATAR_APP_ID=
ALIYUN_AVATAR_INSTANCE_ID=
ALIYUN_AVATAR_ACCESS_KEY_ID=
ALIYUN_AVATAR_ACCESS_KEY_SECRET=
MOFA_AVATAR_ENABLED=false
MOFA_GATEWAY_URL=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session
MOFA_APP_ID=
MOFA_APP_SECRET=
MOFA_SDK_URL=https://media.xingyun3d.com/xingyun3d/general/litesdk/xmovAvatar@latest.js
MOFA_CRYPTO_URL=https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js
MOFA_EMOTION_ENABLED=false
MOFA_AUTHORIZATION=
IFLYTEK_AVATAR_ENABLED=false
IFLYTEK_GATEWAY_URL=
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
FAY_ENABLED=false
FAY_BASE_URL=
