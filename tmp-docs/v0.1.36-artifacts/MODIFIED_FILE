import { RefreshCw } from 'lucide-react'
import { useMemo } from 'react'
import { useState } from 'react'
import { EvaluationTables } from '../features/evaluation/components/EvaluationTables'
import { EvaluationTrendCharts } from '../features/evaluation/components/EvaluationTrendCharts'
import { useEvaluationData } from '../features/evaluation/model'
import { deriveOverview } from '../features/evaluation/presentation'
import { useObservabilityEvents } from '../features/observability/model'
import { PageHeader } from '../shared/components/PageHeader'
import * as evaluationApi from '../features/evaluation/api'
import type { EvaluationRawRunWire, EvaluationRunWire } from '../features/evaluation/types'
import { duration, integer, money, percent } from '../features/evaluation/presentation'

export function EvaluationPage() {
  const telemetry = useObservabilityEvents(300)
  const evaluation = useEvaluationData()
  const [category, setCategory] = useState('全部')
  const [rawRun, setRawRun] = useState<EvaluationRawRunWire | null>(null)
  const [rawLoading, setRawLoading] = useState(false)
  const [showAllRuns, setShowAllRuns] = useState(false)
  const overview = evaluation.overview ?? deriveOverview(evaluation.runs, telemetry.events.length)
  const errorCount = useMemo(
    () => telemetry.events.filter((event) => event.status === 'error' || event.error_message).length,
    [telemetry.events],
  )
  const categories = useMemo(() => {
    const names = new Set<string>()
    evaluation.datasets.forEach((dataset) => Object.keys(dataset.categories ?? {}).forEach((name) => names.add(name)))
    return ['全部', ...Array.from(names).sort()]
  }, [evaluation.datasets])
  const sampleCount = evaluation.datasets.reduce((total, item) => total + Number(item.sampleCount ?? item.sample_count ?? 0), 0)
  const visibleRuns = showAllRuns ? evaluation.runs : evaluation.runs.slice(0, 10)
  async function inspectRun(run: EvaluationRunWire) {
    if (!run.id) return
    setRawLoading(true)
    try { setRawRun(await evaluationApi.getRawRun(run.id)) } catch (cause) { setRawRun({ request: { error: cause instanceof Error ? cause.message : '原始数据读取失败' } }) } finally { setRawLoading(false) }
  }
  return (
    <div className="page-stack">
      <PageHeader eyebrow="EVALUATION" title="评测中心" description="集中查看质量、安全、成本与分段延迟。" actions={<div className="page-header-actions"><button className="icon-button" type="button" onClick={() => { void telemetry.refresh(); void evaluation.refresh() }} disabled={telemetry.isRefreshing || evaluation.isRefreshing} aria-label="刷新评测数据" title="刷新评测数据"><RefreshCw size={16} className={telemetry.isRefreshing || evaluation.isRefreshing ? 'spin' : undefined} /></button></div>} />
      <section className="evaluation-context" aria-label="评测概况"><div><strong>{overview?.totalRuns ?? 0}</strong><span>次评测运行</span></div><div><strong>{sampleCount}</strong><span>个可用样本</span></div><div><strong>{categories.length - 1}</strong><span>个场景分类</span></div><div className={errorCount ? 'evaluation-context-alert' : ''}><strong>{errorCount}</strong><span>个异常事件</span></div></section>
      <section className="work-panel evaluation-controls" aria-label="评测筛选"><label htmlFor="evaluation-category">场景分类</label><select id="evaluation-category" value={category} onChange={(event) => setCategory(event.target.value)}>{categories.map((item) => <option value={item} key={item}>{item}</option>)}</select><span>筛选数据集与运行记录 · 统计来自真实接口</span></section>
      {(telemetry.error || evaluation.error) && <div className="page-alert" role="alert">{telemetry.error || evaluation.error}</div>}
      {evaluation.unavailable.length > 0 && <div className="page-note" role="status">评测数据接口尚未提供，质量指标会显示为暂无数据。</div>}
      <EvaluationTrendCharts runs={evaluation.runs} currency={overview?.currency} showingAll={showAllRuns} onToggleAll={() => setShowAllRuns((current) => !current)} onSelectRun={(run) => void inspectRun(run)} />
      <EvaluationTables datasets={evaluation.datasets} runs={visibleRuns} category={category} runningDatasetId={evaluation.runningDatasetId} onRunDataset={evaluation.runDataset} onSelectRun={(run) => void inspectRun(run)} />
      {rawRun && <section className="work-panel raw-run-panel" aria-labelledby="raw-run-title"><div className="section-heading"><div><p className="eyebrow">RUN DETAIL</p><h2 id="raw-run-title">这一轮发生了什么</h2></div><button className="icon-button" type="button" aria-label="关闭原始数据" title="关闭" onClick={() => setRawRun(null)}>×</button></div>{rawLoading ? <p>正在读取归档…</p> : <HumanReadableRun rawRun={rawRun} />}</section>}
    </div>
  )
}

function HumanReadableRun({ rawRun }: { rawRun: EvaluationRawRunWire }) {
  const request = rawRun.request ?? {}
  const run = rawRun.run ?? {}
  const input = textValue(request.input_text ?? request.inputText)
  const output = textValue(request.output_text ?? request.outputText ?? run.output_preview ?? run.outputPreview)
  return <div className="human-run-detail"><div className="human-run-summary"><div><span>运行结果</span><strong>{humanStatus(run.status)}</strong></div><div><span>成功率</span><strong>{percent(run.successRate ?? run.success_rate)}</strong></div><div><span>总耗时</span><strong>{duration(run.durationMs ?? run.duration_ms)}</strong></div><div><span>Token 用量</span><strong>{integer(run.totalTokens ?? run.total_tokens)}</strong></div><div><span>本轮成本</span><strong>{money(run.cost, run.currency ?? 'CNY')}</strong></div></div><div className="human-run-columns"><div><h3>用户输入</h3><p>{input || '未记录用户输入'}</p></div><div><h3>数字人回答</h3><p>{output || '未记录回答内容'}</p></div></div><details className="raw-run-advanced"><summary>查看原始字段</summary><pre>{JSON.stringify(rawRun, null, 2).slice(0, 50000)}</pre></details></div>
}

function textValue(value: unknown): string {
  return typeof value === 'string' ? value.trim() : value === undefined || value === null ? '' : String(value)
}

function humanStatus(value?: string): string {
  const labels: Record<string, string> = { success: '已完成', completed: '已完成', passed: '已通过', failed: '失败', error: '异常', blocked: '已拦截', interrupted: '已中断' }
  return labels[String(value ?? '').toLowerCase()] ?? '状态暂无'
}
